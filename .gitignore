# macOS
.DS_Store
*.swp
*.swo

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android local config (machine-specific – never commit this)
MyApp/android/local.properties

# Android build artefacts
MyApp/android/.gradle/
MyApp/android/app/build/
MyApp/android/build/
*.apk
*.aab

# iOS
MyApp/ios/Pods/
MyApp/ios/build/
MyApp/ios/*.xcworkspace/xcuserdata/
*.pbxuser
!default.pbxuser
*.xcuserstate
*.xcworkspace/xcuserdata/

# Metro Bundler cache
MyApp/.metro-health-check*
MyApp/.cache/

# React Native
MyApp/.expo/

# Gradle wrapper (keep the scripts, not the jar or properties generated by gradlew)
!MyApp/android/gradle/wrapper/gradle-wrapper.jar

# Editor
.idea/
*.iml
.vscode/
